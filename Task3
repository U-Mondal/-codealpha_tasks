import tensorflow as tf
from tensorflow.keras import layers, models

# 1. Load the MNIST dataset (built into TensorFlow)
mnist = tf.keras.datasets.mnist
(X_train, y_train), (X_test, y_test) = mnist.load_data()

# 2. Normalize pixel values to be between 0 and 1
X_train, X_test = X_train / 255.0, X_test / 255.0

# 3. Reshape images to include a single color channel for the CNN
X_train = X_train[..., tf.newaxis]
X_test = X_test[..., tf.newaxis]

# 4. Build a simple Convolutional Neural Network (CNN)
model = models.Sequential([
    layers.Conv2D(32, (3, 3), activation='relu', input_shape=(28, 28, 1)),
    layers.MaxPooling2D((2, 2)),
    layers.Flatten(),
    layers.Dense(64, activation='relu'),
    layers.Dense(10, activation='softmax')
])

# 5. Compile the model
model.compile(optimizer='adam',
              loss='sparse_categorical_crossentropy',
              metrics=['accuracy'])

# 6. Train the model on the data
model.fit(X_train, y_train, epochs=3)

# 7. Evaluate the final accuracy
test_loss, test_acc = model.evaluate(X_test, y_test, verbose=2)
print(f"Test Accuracy: {test_acc}")


